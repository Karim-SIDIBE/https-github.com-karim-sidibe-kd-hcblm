{
  "name": "kd-hcblm-server",
  "version": "0.1.0",
  "private": true,
  "description": "K-HCBLM v2.2 — KOMPETENCES DECLICK learning platform backend",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/server.js",
    "start:prod": "node --import tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "keygen": "tsx scripts/keygen.ts",
    "test": "node --test --import tsx --env-file=.env \"src/**/*.test.ts\"",
    "predev": "prisma generate",
    "pretest": "prisma generate",
    "pretypecheck": "prisma generate",
    "prebuild": "prisma generate"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.5",
    "@kd/shared": "*",
    "@node-rs/argon2": "^2.1.0",
    "@node-saml/node-saml": "^5.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "adm-zip": "^0.6.0",
    "fast-xml-parser": "^5.10.1",
    "fastify": "^5.12.0",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "nodemailer": "^9.0.5",
    "pdfkit": "^0.19.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "prisma": "^7.9.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
