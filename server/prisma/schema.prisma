// K-HCBLM v2.2 — Prisma schema
// ---------------------------------------------------------------------------
// Two faces of the platform (see handoff README):
//   A. AUTHORING  — a Course has many versioned CourseVersions. Each version
//      stores the full authored content as a validated JSONB document whose
//      shape is the Zod "content model" (src/domain/content-model.ts). This is
//      the single contract shared by the authoring form, the publish-time
//      validation engine, and the learner renderer.
//   B. RUNTIME    — learners enrol in a published CourseVersion; their progress,
//      badges and submissions are normalized relational rows (fleshed out in a
//      later step; stubbed here so the model is coherent end-to-end).
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// Enums
// ===========================================================================

/// Platform roles. Beyond the original handoff set, modern-LMS roles are added:
/// SUPER_ADMIN (platform owner), REVIEWER (content approval gate) and INSTRUCTOR
/// (delivery / cohort management).
enum Role {
  LEARNER
  LEARNING_DESIGNER
  REVIEWER
  INSTRUCTOR
  EVALUATOR
  COURSE_ADMIN
  SUPER_ADMIN
  ENTERPRISE_CLIENT
  ENTERPRISE_ADMIN
  EMPLOYER
}

/// Certification levels. Levels differ only by thresholds + content depth.
enum CourseLevel {
  L1
  L2
  L3
}

/// Lifecycle of a single authored version (draft → review → published).
enum CourseStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

/// Enrolment lifecycle.
enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  CERTIFIED
  WITHDRAWN
}

/// Progressive block badges (one per block) + the final certificate.
enum BadgeType {
  ENTRY // Bloc 0
  COMPREHENSION // Bloc 1
  PRACTICE // Bloc 2
  ANCHORING // Bloc 3
  CERTIFICATE // Bloc 4
}

/// Discrete completable items inside a course (engine progress tracking).
enum ItemType {
  PROFILE // Bloc 0 — time-management profile chosen
  TRIGGER_QUIZ // Bloc 0 — non-scored trigger quiz
  PEER // Bloc 0 — progress peer designated
  MICRO_SESSION // a video + exercise micro-session
  DIAGNOSTIC_QUIZ // Bloc 1 — scored diagnostic
  CASE_STUDY // Bloc 1 — Nadia
  GUIDED_SCENARIOS // Bloc 2 — guided situations
  INTER_BLOCK_QUIZ // Bloc 2 — non-scored consolidation quiz
  FIELD_APPLICATION // Bloc 2 — field application (gates Bloc 3)
  SELF_ASSESSMENT // Bloc 3 — 6-criteria self assessment
  ACTION_PLAN // Bloc 3 — 30-day plan
  FINAL_QUIZ // Bloc 3 — scored final quiz (gates Bloc 4)
  PROJECT // Bloc 4 — certifying project submission
  JOURNAL_ENTRY // Bloc 4 — one of the 6 micro-entries
  RUBRIC_EVALUATION // Bloc 4 — human evaluator score
}

// ===========================================================================
// Identity
// ===========================================================================

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      Role     @default(LEARNER)
  /// Mobile number for SMS / WhatsApp re-engagement (§7.2). Optional.
  phone     String?
  /// Argon2id hash for first-party password auth (null = SSO-only / no password).
  passwordHash String?
  /// Brute-force lockout (OWASP): failed-attempt counter + temporary lock.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  /// Account deactivation (B2B seat lifecycle). Non-null = disabled: blocked at
  /// login/refresh and frees its organization seat. Re-enabling re-checks quota.
  disabledAt       DateTime?
  /// B2C self-registration: set when the e-mail has been verified (OTP). Null =
  /// unverified → first-party login is blocked. Staff/SSO-created accounts are
  /// set verified at creation; existing accounts were backfilled at migration.
  emailVerifiedAt  DateTime?
  /// 2FA TOTP (RFC 6238). `totpSecret` is the base32 secret (set at setup);
  /// `totpEnabledAt` non-null = 2FA active (login requires a code). Backup codes
  /// are stored as SHA-256 hashes and consumed on use.
  totpSecret       String?
  totpEnabledAt    DateTime?
  totpBackupCodes  String[]  @default([])
  /// RGPD Art. 17 (right to erasure): set when the account has been anonymised —
  /// direct identifiers scrubbed and sessions revoked. Learning history is kept
  /// de-identified for analytics integrity. Distinct from a hard delete.
  anonymizedAt     DateTime?
  /// Scheduled (reversible) erasure: when set, the account is disabled immediately
  /// but data is destroyed only after the grace period, by the retention job —
  /// `deletionMode` ("anonymize" | "delete") decides how. An admin can restore
  /// (clearing these) any time before the purge runs.
  deletionRequestedAt DateTime?
  deletionMode        String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authoredCourses  Course[]              @relation("CourseAuthor")
  reviewedVersions CourseVersion[]       @relation("VersionReviewer")
  enrollments      Enrollment[]
  refreshTokens    RefreshToken[]
  orgMemberships   OrganizationMembership[]
  hostedSessions   LiveSession[]         @relation("SessionHost")
  sessionRegistrations SessionRegistration[]
  cohortMemberships CohortMembership[]
  authoredThreads  ForumThread[]         @relation("ThreadAuthor")
  authoredPosts    ForumPost[]           @relation("PostAuthor")
  evaluatorAssignments ProjectSubmission[] @relation("EvaluatorAssignments")
  accreditations       EvaluatorAccreditation[] @relation("AccreditationHolder")
  accreditationsGranted EvaluatorAccreditation[] @relation("AccreditationGranter")
  verificationCodes VerificationCode[]
  consents          Consent[]
  devices           Device[]
  savedViews        SavedView[]

  @@index([role])
}

/// A named, per-user configuration of an admin list screen (columns, filters,
/// search, sort). Stored server-side so views follow the account across
/// browsers instead of living in localStorage.
model SavedView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Which admin screen the view belongs to (e.g. "learners", "audit").
  screen    String
  name      String
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, screen, name])
  @@index([userId, screen])
}

/// One-time codes for B2C e-mail/phone verification (OTP). Only the hash of the
/// code is stored; codes expire and are single-use.
model VerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  purpose    String    @default("EMAIL_VERIFY")
  expiresAt  DateTime
  consumedAt DateTime?
  /// Failed verification attempts against this code; the code is invalidated once
  /// it reaches the cap (anti-brute-force on the 6-digit OTP).
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@index([userId])
}

/// RGPD consent ledger (Art. 6/7). One row per grant; revoking sets `revokedAt`
/// (history is kept). `version` records which policy text was accepted. Current
/// state per type = the most recent row, granted iff `revokedAt` is null.
model Consent {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String    // "terms" | "privacy" | "marketing"
  version   String    // policy version accepted, e.g. "2026-06"
  grantedAt DateTime  @default(now())
  revokedAt DateTime?
  ip        String?

  @@index([userId, type])
}

/// Rotating refresh tokens with reuse detection (OAuth 2.0 Security BCP, RFC 9700).
/// Only the SHA-256 of the opaque token is stored. A whole `familyId` is revoked
/// when a previously-rotated (revoked) token is presented again.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId     String // rotation family
  tokenHash    String    @unique // sha256(opaque token)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String? // next token in the rotation chain
  /// Device transparency (RGPD/security): captured at issuance, refreshed on
  /// rotation so "my active sessions" can show device + last activity.
  userAgent    String?
  ip           String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

/// Append-only audit trail for security-sensitive events.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // principal id (null for anonymous / system)
  action     String // e.g. "auth.login.success", "course.publish"
  targetType String?
  targetId   String?
  ip         String?
  meta       Json?
  at         DateTime @default(now())

  @@index([action])
  @@index([actorId])
  @@index([at])
}

// ===========================================================================
// A. Authoring — Course + versioned content document
// ===========================================================================

/// A tenant (organization / workspace). Org-scoped resources are isolated to it;
/// resources with no organization are the shared platform catalog.
model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /// SCIM provisioning bearer-token hash (set when SCIM is enabled for the org).
  scimTokenHash String?
  /// Licensed learner seats (B2B). Set by the platform; an org admin may create
  /// learners only up to this count. 0 = no self-service seats configured.
  /// Seats consumed = memberships with orgRole MEMBER (the org's own admins are free).
  seats     Int      @default(0)
  createdAt DateTime @default(now())

  memberships OrganizationMembership[]
  courses     Course[]
  webhooks    Webhook[]
}

/// Outbound webhook subscription (§8.2) — integrates with employer HR systems,
/// LinkedIn certification import, and investor reporting. Org-scoped (null = the
/// platform). Payloads are HMAC-SHA256 signed with `secret`.
model Webhook {
  id             String         @id @default(cuid())
  organizationId String?
  organization   Organization?  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  url            String
  secret         String
  events         WebhookEvent[]
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  deliveries WebhookDelivery[]

  @@index([organizationId])
}

/// One attempt-log row per (webhook, event) — the durable delivery queue.
model WebhookDelivery {
  id           String       @id @default(cuid())
  webhookId    String
  webhook      Webhook      @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        WebhookEvent
  payload      Json
  status       String       @default("PENDING") // PENDING | SENT | FAILED
  attempts     Int          @default(0)
  responseCode Int?
  error        String?
  createdAt    DateTime     @default(now())
  sentAt       DateTime?

  @@index([webhookId])
  @@index([status])
}

enum WebhookEvent {
  BADGE_ISSUED
  BLOCK_COMPLETED
  PROJECT_SUBMITTED
  REENGAGEMENT_DAY14
  CERTIFICATE_ISSUED
  EXERCISE_SUBMITTED
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model OrganizationMembership {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgRole        OrgRole      @default(MEMBER)
  /// External id when provisioned via SCIM.
  scimExternalId String?
  createdAt      DateTime     @default(now())

  @@unique([organizationId, userId])
  @@index([userId])
}

model Course {
  id        String   @id @default(cuid())
  /// Stable human-readable identifier, e.g. "gestion-du-temps-n1".
  slug      String   @unique
  /// Owning tenant; null = shared platform catalog.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String?
  author   User?   @relation("CourseAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  versions     CourseVersion[]
  enrollments  Enrollment[]
  accreditations EvaluatorAccreditation[]
  aiCalibrations AiCalibration[]
  liveSessions LiveSession[]
  cohorts      Cohort[]

  @@index([authorId])
}

/// A cohort — a group of learners, optionally tied to a course. Forums are
/// scoped per cohort ("forum de pratique optionnel par cohorte", Pilier 6.3).
model Cohort {
  id          String   @id @default(cuid())
  name        String
  courseId    String?
  course      Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createdById String?
  createdAt   DateTime @default(now())

  memberships CohortMembership[]
  threads     ForumThread[]

  @@index([courseId])
}

model CohortMembership {
  id        String   @id @default(cuid())
  cohortId  String
  cohort    Cohort   @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([cohortId, userId])
  @@index([userId])
}

model ForumThread {
  id        String      @id @default(cuid())
  cohortId  String
  cohort    Cohort      @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation("ThreadAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  locked    Boolean     @default(false)
  pinned    Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  posts ForumPost[]

  @@index([cohortId])
}

model ForumPost {
  id        String      @id @default(cuid())
  threadId  String
  thread    ForumThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation("PostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  body      String
  editedAt  DateTime?
  deletedAt DateTime? // soft delete for moderation
  createdAt DateTime    @default(now())

  @@index([threadId])
}

/// A registered LTI 1.3 Platform (an LMS that launches into us, the Tool).
model LtiPlatform {
  id           String     @id @default(cuid())
  name         String?
  issuer       String
  clientId     String
  deploymentId String?
  authLoginUrl String // platform OIDC auth endpoint
  jwksUrl      String // platform public keys
  tokenUrl     String? // platform OAuth token endpoint (AGS/NRPS)
  createdById  String?
  createdAt    DateTime   @default(now())
  nonces       LtiNonce[]

  @@unique([issuer, clientId])
}

/// Short-lived state/nonce bridging the LTI OIDC login → launch.
model LtiNonce {
  id            String      @id @default(cuid())
  state         String      @unique
  nonce         String
  platformId    String
  platform      LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  targetLinkUri String?
  createdAt     DateTime    @default(now())
  expiresAt     DateTime
}

/// Imported interoperable content packages (SCORM 1.2 / 2004, cmi5).
enum ImportType {
  SCORM12
  SCORM2004
  CMI5
}

model ImportedPackage {
  id           String              @id @default(cuid())
  type         ImportType
  title        String
  storagePrefix String // object-key prefix where the package files live
  launchHref   String // entry file relative to the prefix
  structure    Json? // parsed manifest structure (items / AUs)
  createdById  String?
  createdAt    DateTime            @default(now())

  registrations ScormRegistration[]
  inbound       InboundStatement[]

  @@index([type])
}

/// Per-learner runtime tracking for an imported package (SCORM data model / cmi5 state).
model ScormRegistration {
  id               String          @id @default(cuid())
  packageId        String
  package          ImportedPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  userId           String
  completion       String? // completed | incomplete | not attempted
  success          String? // passed | failed | unknown
  scoreScaled      Float?
  scoreRaw         Int?
  location         String?
  suspendData      String?
  totalTimeSeconds Int?
  cmi              Json? // raw SCORM cmi tree
  authToken        String? // cmi5 inbound auth token
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  @@unique([packageId, userId])
  @@index([userId])
}

/// xAPI statements received from imported cmi5/xAPI content (inbound LRS).
model InboundStatement {
  id        String           @id @default(cuid())
  packageId String?
  package   ImportedPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  userId    String?
  verb      String
  statement Json
  storedAt  DateTime         @default(now())

  @@index([packageId])
}

/// Media pipeline — uploaded assets transcoded into an adaptive rendition ladder
/// (low-bandwidth + offline-downloadable variants).
enum MediaKind {
  VIDEO
  AUDIO
  CAPTIONS
  IMAGE
}

enum MediaStatus {
  UPLOADED
  PROCESSING
  READY
  FAILED
}

/// Folder in the authoring media library (typically one folder per course).
/// One execution of a background job (manual run or scheduler tick) — the
/// admin jobs monitor reads this. Old rows are pruned by the recorder.
model JobRun {
  id         String    @id @default(cuid())
  /// Job key (e.g. "re-engagement", "lrs-retention").
  name       String
  /// "manual" (admin console) or "scheduler".
  trigger    String    @default("manual")
  actorId    String?
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean?
  result     Json?
  error      String?

  @@index([name, startedAt])
  @@index([startedAt])
}

/// Platform-wide settings (key → JSON value). E.g. "require_staff_2fa".
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

/// Super-admin override of one learner-app interface text. Defaults live in
/// @kd/shared/ui-texts; only edited keys are stored (delete = revert).
model UiText {
  id          String   @id @default(cuid())
  app         String   @default("web")
  locale      String // "fr" | "en"
  key         String
  value       String
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  @@unique([app, locale, key])
}

model MediaFolder {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  assets MediaAsset[]
}

model MediaAsset {
  id               String      @id @default(cuid())
  kind             MediaKind   @default(VIDEO)
  originalFilename String?
  mime             String
  sizeBytes        Int?
  durationSec      Int?
  width            Int?
  height           Int?
  status           MediaStatus @default(UPLOADED)
  storageKey       String // source object key
  error            String?
  createdById      String?
  /// Library folder; null = library root. The service refuses to delete a
  /// non-empty folder (SetNull is the schema-level safety net).
  folderId         String?
  folder           MediaFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  renditions MediaRendition[]

  @@index([status])
  @@index([folderId])
}

model MediaRendition {
  id          String     @id @default(cuid())
  assetId     String
  asset       MediaAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  label       String // "source", "480p", "240p-lite", "audio", "captions-fr"
  kind        MediaKind
  mime        String
  storageKey  String? // local/object key (null when external)
  url         String? // external/provider URL (null when stored)
  bitrateKbps Int?
  width       Int?
  height      Int?
  language    String? // for captions
  sizeBytes   Int?
  downloadable Boolean   @default(false) // suitable for offline download
  available    Boolean   @default(true) // false = planned but not yet transcoded
  createdAt    DateTime   @default(now())

  @@index([assetId])
}

/// Blended / instructor-led live sessions (Zoom, Teams, or a manual link).
enum MeetingProvider {
  ZOOM
  TEAMS
  MANUAL
}

enum SessionStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
}

model LiveSession {
  id                String          @id @default(cuid())
  /// Optional association with a course (blended learning).
  courseId          String?
  course            Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  title             String
  description       String?
  provider          MeetingProvider @default(MANUAL)
  startsAt          DateTime
  durationMin       Int
  timezone          String          @default("UTC")
  joinUrl           String?
  externalMeetingId String? // the provider's meeting id
  hostUserId        String?
  host              User?           @relation("SessionHost", fields: [hostUserId], references: [id], onDelete: SetNull)
  capacity          Int?
  status            SessionStatus   @default(SCHEDULED)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  registrations SessionRegistration[]

  @@index([courseId])
  @@index([startsAt])
}

model SessionRegistration {
  id                String      @id @default(cuid())
  sessionId         String
  session           LiveSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  registeredAt      DateTime    @default(now())
  attended          Boolean     @default(false)
  attendanceMinutes Int?

  @@unique([sessionId, userId])
  @@index([userId])
}

model CourseVersion {
  id       String @id @default(cuid())
  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  /// Monotonic version number within a course (1, 2, 3 …).
  version Int
  status  CourseStatus @default(DRAFT)

  // --- denormalized headline fields (mirrors of content.*, kept for querying) ---
  title         String
  level         CourseLevel
  language      String      @default("fr")
  domainCode    String // e.g. "D4"
  domainLabel   String // e.g. "Productivité & organisation"
  passThreshold Int // Bloc 3 final-quiz threshold: 70 | 75 | 80

  /// The full authored content document — conforms to the Zod content model.
  /// This is the payload the authoring tool produces and the learner UI renders.
  content Json

  // --- review workflow (draft → in_review → published) ---
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?     @relation("VersionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes  String?

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enrollments  Enrollment[]
  searchChunks SearchChunk[]

  @@unique([courseId, version])
  @@index([status])
}

/// Embedded content chunks for semantic search (one set per course version).
/// Vectors stored as JSON float arrays; cosine ranking is computed in-process
/// (swap for pgvector at scale).
model SearchChunk {
  id              String        @id @default(cuid())
  courseVersionId String
  courseVersion   CourseVersion @relation(fields: [courseVersionId], references: [id], onDelete: Cascade)
  blockIndex      Int?
  path            String // locator, e.g. "blocks[1].diagnostic.q3"
  text            String
  embedding       Json // number[]
  model           String
  createdAt       DateTime      @default(now())

  @@index([courseVersionId])
}

// ===========================================================================
// B. Runtime — learner enrolment + badges (stubs; expanded in a later step)
// ===========================================================================

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId        String
  course          Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseVersionId String
  courseVersion   CourseVersion    @relation(fields: [courseVersionId], references: [id])
  status          EnrollmentStatus @default(ACTIVE)

  /// The Moment d'Ancrage (PAM) text — captured once at Bloc 0, then injected
  /// everywhere ({{moment_ancrage}}). Stored at enrolment scope for fast reuse.
  momentAncrage String?

  /// Progress peer (Pilier 6.3) — notified at each badge.
  peerName  String?
  peerEmail String?
  /// Peer mobile number for SMS / WhatsApp delivery (§7.1 — African reach).
  peerPhone String?
  /// Consentement au partage de progression avec le pair, recueilli au moment
  /// de la désignation (K-HCBLM v2.2, Pilier 6.3). Conditionne toute
  /// notification au pair. `true` par défaut pour les désignations antérieures
  /// à la collecte explicite (comportement historique conservé).
  peerConsent Boolean @default(true)

  /// Enterprise enrolment → J+14 inactivity signals go to the admin (Pilier 6.4).
  isEnterprise Boolean @default(false)

  // --- auto-resume (Pilier 6.2): exact position the learner last touched ---
  lastBlockIndex Int?
  lastItemKey    String?
  lastSeenAt     DateTime?

  /// Anchor for the journal trigger schedule (Pilier 5.1): set when the
  /// certification block first unlocks ("block start").
  journalStartedAt DateTime?

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  badges         Badge[]
  completions    ItemCompletion[]
  reEngagements  ReEngagementMessage[]
  xapi           XapiStatement[]
  notifications  Notification[]
  aiAssessments  AiAssessment[]
  syncOperations SyncOperation[]
  credentials    Credential[]
  tutorSessions  TutorSession[]
  mediaPositions MediaPosition[]
  journalTriggers JournalTrigger[]
  quizDraws      QuizDraw[]
  projectSubmission ProjectSubmission?
  appeal         Appeal?
  doubleMarkings DoubleMarking[]

  @@unique([userId, courseId])
  @@index([status])
}

/// Procédure de recours (socle §10) : contestation d'une décision devant une
/// instance distincte de celle qui l'a prise. Un SEUL recours par dossier —
/// la décision issue du recours est finale. Le registre exigé par le socle
/// (date, candidat, critères contestés, écart, décision finale) est cette
/// table, conservée sans limite de durée.
model Appeal {
  id                String     @id @default(cuid())
  enrollmentId      String     @unique
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  openedAt          DateTime   @default(now())
  /// Étape 1 : critères contestés (labels) + éléments non pris en compte.
  contestedCriteria Json
  statement         String
  /// Photographie de la première notation au moment de l'ouverture.
  firstEvaluatorId  String?
  firstScores       Json
  firstTotal        Int
  /// Étape 2 : second évaluateur (n'a pas participé à la première notation,
  /// ne connaît pas les scores attribués) — désigné sous 5 jours ouvrables.
  secondEvaluatorId String?
  secondAssignedAt  DateTime?
  /// Étape 3 : notation à l'aveugle sous 10 jours ouvrables, avec preuves.
  secondScores      Json?
  secondTotal       Int?
  secondGradedAt    DateTime?
  /// Étape 4 : écart des totaux — < 10 : la moyenne fait foi ; ≥ 10 : un
  /// troisième évaluateur tranche et sa décision est définitive.
  gap               Int?
  thirdEvaluatorId  String?
  thirdAssignedAt   DateTime?
  thirdScores       Json?
  thirdTotal        Int?
  /// Étape 5 : décision finale appliquée + notification motivée sous 3 jours
  /// ouvrables.
  finalScores       Json?
  finalTotal        Int?
  finalDecision     String?
  decidedAt         DateTime?
  /// OPEN → SECOND_ASSIGNED → THIRD_REQUIRED → THIRD_ASSIGNED → DECIDED.
  status            String     @default("OPEN")
  /// Échéances des étapes 2, 3 et 5 (jours ouvrables).
  step2DueAt        DateTime?
  step3DueAt        DateTime?
  step5DueAt        DateTime?

  @@index([status])
}

/// Surveillance continue (socle §9.3) : 10 % des dossiers réels notés en
/// double à l'aveugle. La note officielle NE CHANGE PAS — l'écart alimente la
/// médiane trimestrielle (> 8 : réviser la grille ou recalibrer) et les
/// incidents individuels (> 15 : un troisième évaluateur tranche, consigné).
model DoubleMarking {
  id                String     @id @default(cuid())
  enrollmentId      String
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Rang du dossier noté qui a déclenché la sélection (0 = ajout manuel).
  sequence          Int        @default(0)
  firstEvaluatorId  String?
  firstScores       Json
  firstTotal        Int
  secondEvaluatorId String?
  assignedAt        DateTime?
  secondScores      Json?
  secondTotal       Int?
  gradedAt          DateTime?
  gap               Int?
  /// REQUIRED → ASSIGNED → GRADED | INCIDENT → RESOLVED.
  status            String     @default("REQUIRED")
  thirdEvaluatorId  String?
  thirdTotal        Int?
  resolutionNotes   String?
  resolvedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@index([enrollmentId])
  @@index([status])
}

/// Grounded AI tutor (RAG over the course content). One conversation thread.
model TutorSession {
  id           String         @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  title        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  messages     TutorMessage[]

  @@index([enrollmentId])
}

enum TutorRole {
  USER
  ASSISTANT
}

model TutorMessage {
  id        String       @id @default(cuid())
  sessionId String
  session   TutorSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      TutorRole
  content   String
  /// For assistant turns: the retrieved citations [{blockIndex, path, snippet}].
  citations Json?
  grounded  Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([sessionId])
}

/// Idempotency ledger for offline-first sync: one row per applied client action,
/// so replaying a queued action batch never double-applies (Pilier 6.2, offline).
model SyncOperation {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  /// Client-generated operation id (the idempotency key).
  opId         String
  type         String
  clientTs     DateTime
  appliedAt    DateTime   @default(now())

  @@unique([enrollmentId, opId])
  @@index([enrollmentId])
}

/// One per fired journal prompt (Pilier 5.1) — idempotent per (enrolment, day).
model JournalTrigger {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  day          Int // J+1, J+3, J+5, J+7, J+10, J+14
  sentAt       DateTime   @default(now())

  @@unique([enrollmentId, day])
  @@index([enrollmentId])
}

/// Exact in-session position for auto-resume (Pilier 3.2 / 4.2): the video
/// offset (to the nearest 5s) per micro-session, stored server-side so resume
/// works across devices. One row per (enrolment, block, item).
model MediaPosition {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  blockIndex   Int
  itemKey      String
  positionSec  Int        @default(0)
  durationSec  Int?
  updatedAt    DateTime   @updatedAt

  @@unique([enrollmentId, blockIndex, itemKey])
  @@index([enrollmentId])
}

/// Bloc 4 certification project lifecycle (Pilier 6.3) — the authoritative
/// in-platform record for employer / institutional verification: submission,
/// evaluator assignment, per-criterion rubric result, written feedback,
/// pass/fail, revision status, and the 5-business-day SLA alert state.
/// One per enrolment (the final certification deliverable).
model ProjectSubmission {
  id             String         @id @default(cuid())
  enrollmentId   String         @unique
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  blockIndex     Int
  /// Submission payload: file references or rich-text body.
  submittedAt    DateTime       @default(now())
  content        Json?
  /// Evaluator assignment (an EVALUATOR / staff user).
  evaluatorId    String?
  evaluator      User?          @relation("EvaluatorAssignments", fields: [evaluatorId], references: [id], onDelete: SetNull)
  assignedAt     DateTime?
  /// Evaluation result — mirrors the rubric completion for the verification API.
  scoreTotal     Int?
  criteria       Json?
  feedback       String?
  result         ProjectResult?
  evaluatedAt    DateTime?
  /// SUBMITTED → ASSIGNED → PASSED | REVISION_REQUESTED | NOT_CERTIFIED.
  revisionStatus ProjectStatus  @default(SUBMITTED)
  /// Décision du socle §6 (CERTIFIED · RESUBMIT · NOT_CERTIFIED) — archivée
  /// avec la fiche (conditions exclusives, la règle des minimums prime).
  decision       String?
  /// Version de la grille appliquée (socle §6 : « archivée avec la fiche de
  /// notation et la version de la grille » — condition d'auditabilité).
  gridVersion    String?
  /// Day+5 SLA: set once the admin alert has fired (idempotent).
  slaAlertedAt   DateTime?
  /// Brouillon de notation de l'évaluateur (socle §8.6) : la suggestion IA ne
  /// s'affiche qu'APRÈS saisie et enregistrement du score humain.
  draftScores    Json?
  draftAt        DateTime?
  /// Étage de recours (socle §10) : 0 = aucun. > 0 → suggestion IA
  /// indisponible (§8.7, notation à l'aveugle du 2e/3e évaluateur).
  appealStage    Int            @default(0)

  @@index([evaluatorId])
}

enum ProjectResult {
  PASS
  FAIL
}

/// Habilitation d'un évaluateur sur UN parcours (socle §9.2) : accordée après
/// calibration (3 dossiers de référence à l'aveugle, écart ≤ 8 pts, ≤ 1 bande),
/// valable 12 mois, à refaire après toute révision de la grille. Historique
/// conservé (une ligne par octroi) ; l'habilitation active est la plus récente
/// non révoquée et non expirée. Assignation ET notation l'exigent.
model EvaluatorAccreditation {
  id          String    @id @default(cuid())
  evaluatorId String
  evaluator   User      @relation("AccreditationHolder", fields: [evaluatorId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  grantedAt   DateTime  @default(now())
  expiresAt   DateTime
  grantedById String?
  grantedBy   User?     @relation("AccreditationGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  /// Résumé du test de calibration (écarts constatés sur les 3 dossiers).
  notes       String?
  revokedAt   DateTime?

  @@index([evaluatorId, courseId])
  @@index([courseId])
}

enum ProjectStatus {
  SUBMITTED
  ASSIGNED
  PASSED
  REVISION_REQUESTED
  /// Socle §6 : total < 55 ou ≥ 2 minimums non atteints — reprise du Bloc 2
  /// ou 3 conseillée avant nouvelle soumission.
  NOT_CERTIFIED
}

/// One row per completed content item for an enrolment.
model ItemCompletion {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  blockIndex   Int
  itemType     ItemType
  /// Stable key within the block: micro-session id ("1.1"), "diagnostic",
  /// "final", "J+3", "project", "scenarios", … (singletons use a fixed key).
  itemKey      String
  /// Score for scored items (diagnostic, final quiz, rubric evaluation).
  scorePct     Int?
  /// Raw payload (answers, profile choice, submission text…).
  data         Json?
  completedAt  DateTime   @default(now())

  @@unique([enrollmentId, blockIndex, itemKey])
  @@index([enrollmentId])
}

model Badge {
  id           String      @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment  @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  type         BadgeType
  /// Personalized message anchored in the learner's Moment d'Ancrage.
  message      String?
  /// Whether the progress peer has been notified (Pilier 6.3).
  peerNotified Boolean     @default(false)
  issuedAt     DateTime    @default(now())
  credential   Credential?

  @@unique([enrollmentId, type])
}

/// Verifiable credential for an issued badge: Open Badges 2.0 hosted assertion
/// (JSON-LD) + Open Badges 3.0 Verifiable Credential signed as a VC-JWT (ES256,
/// verifiable via the platform JWKS). Recipient identity is salted-hashed.
model Credential {
  id               String     @id @default(cuid())
  badgeId          String     @unique
  badge            Badge      @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  enrollmentId     String
  enrollment       Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  achievementType  String
  recipientSalt    String
  recipientHash    String // sha256(email + salt)
  assertion        Json // OB 2.0 hosted assertion
  vcJwt            String // OB 3.0 VC-JWT
  issuedAt         DateTime   @default(now())
  revokedAt        DateTime?
  revocationReason String?

  @@index([enrollmentId])
}

/// Proactive re-engagement of inactive learners (Pilier 6.4).
enum ReEngagementStage {
  J3 // 3 days inactive
  J7 // 7 days inactive — message anchored in the Moment d'Ancrage
  J14 // 14 days inactive — admin signal for enterprise enrolments
}

enum NotifChannel {
  LEARNER
  ADMIN
}

model ReEngagementMessage {
  id           String            @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment        @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  stage        ReEngagementStage
  channel      NotifChannel      @default(LEARNER)
  body         String
  sentAt       DateTime          @default(now())

  @@index([enrollmentId, stage])
}

/// Per-learner materialised quiz draw (random pool from the bank), stored once
/// per (enrollment, quiz) so the set is stable across bundle rebuilds + scoring.
model QuizDraw {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  quizKey      String // "diagnostic" | "interblock" | "final"
  questions    Json // the materialised ScoredQuestion[] for this learner
  createdAt    DateTime   @default(now())

  @@unique([enrollmentId, quizKey])
}

/// Reusable question bank — a stored ScoredQuestion (validated on write) that
/// authors insert into course quizzes. Tagged by sub-area for filtering/draws.
model BankQuestion {
  id          String   @id @default(cuid())
  question    Json // a ScoredQuestion (validated against @kd/shared on write)
  subArea     String   @default("")
  level       String   @default("")
  /// "approved" (usable by pools/draws) or "pending" (awaiting human review).
  status      String   @default("approved")
  /// Where the question came from: "manual" | "course" (harvested at publish/
  /// import) | "ai" (generated variant awaiting review).
  origin      String   @default("manual")
  /// Provenance for idempotent course harvesting and variant traceability.
  sourceCourseId   String?
  sourceQuestionId String?
  /// Free label, e.g. the imposed angle of an AI variant ("contexte terrain").
  note        String   @default("")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([sourceCourseId, sourceQuestionId])
  @@index([subArea])
  @@index([status])
}

/// A registered push device (native app). One row per device token.
model Device {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  platform   String   @default("unknown") // ios | android | web
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  @@index([userId])
}

/// Scheduled e-mail delivery of a course report (Excel/CSV) to recipients.
enum ReportFrequency {
  WEEKLY
  MONTHLY
}

model ReportSchedule {
  id          String          @id @default(cuid())
  courseId    String
  recipients  String[] // e-mail addresses
  frequency   ReportFrequency @default(WEEKLY)
  format      String          @default("xlsx") // "xlsx" | "csv"
  active      Boolean         @default(true)
  lastSentAt  DateTime?
  createdById String?
  createdAt   DateTime        @default(now())

  @@index([courseId])
}

/// xAPI statements emitted to the LRS (Pilier — analytics / interoperability).
model XapiStatement {
  id           String     @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  verb         String // short verb key (e.g. "answered") — the IRI lives in the statement JSON
  objectId     String // activity IRI
  statement    Json // the full xAPI statement
  forwarded    Boolean    @default(false)
  forwardedAt  DateTime?
  forwardError String?
  storedAt     DateTime   @default(now())

  @@index([enrollmentId])
  // Forwarder scan: WHERE forwarded = false ORDER BY storedAt ASC.
  @@index([forwarded, storedAt])
  // Staff LRS query + insights: filter by verb and/or date range, newest first.
  @@index([verb, storedAt])
  @@index([storedAt])
}

enum NotificationChannel {
  CONSOLE
  EMAIL
  WEBHOOK
  SMS
  WHATSAPP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum RecipientKind {
  LEARNER
  PEER
  ADMIN
}

/// AI grading-assistant output (advisory; never auto-applied to certification).
enum AiAssessmentKind {
  FORMATIVE // learner-facing feedback on an open submission
  RUBRIC_SUGGESTION // evaluator-facing per-criterion score suggestion (Bloc 4)
}

model AiAssessment {
  id             String           @id @default(cuid())
  enrollmentId   String
  enrollment     Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  blockIndex     Int
  itemKey        String
  kind           AiAssessmentKind
  feedback       String // overall text / summary
  /// For RUBRIC_SUGGESTION: [{label, weightPoints, suggested, comment,
  /// citations?, absence?, verification?}] — preuve §8.4 incluse.
  criteria       Json?
  /// For RUBRIC_SUGGESTION: provisional total /100 (advisory only).
  suggestedScore Int?
  aiGenerated    Boolean          @default(false)
  provider       String?
  /// Journalisation §8.9 : version de la grille appliquée au moment de la
  /// suggestion (sans elle, les décisions passées deviennent inauditables).
  gridVersion    String?
  /// §8.5 : la preuve d'au moins un critère a échoué → AUCUNE suggestion
  /// affichée ; l'enregistrement reste pour le taux de blocage (§8.10).
  blocked        Boolean          @default(false)
  /// §8.9 : score humain final par critère ([{label, points}]), lié à la
  /// notation. §8.10 : concordance IA/humain.
  finalScores    Json?
  /// §8.9 : indicateur de copie de la preuve par critère ([bool]), calculé
  /// côté serveur (preuve humaine ≡ preuve IA après normalisation).
  copyFlags      Json?
  createdAt      DateTime         @default(now())

  @@index([enrollmentId])
}

/// Calibration de la suggestion automatisée sur UN parcours (socle §8.8) :
/// passée sur les 5 dossiers de référence, écart de total ≤ 8 points sur
/// chacun et aucun critère à plus d'une bande. Tant que le dernier passage
/// pour (parcours, modèle, version de grille) n'est pas `passed`, le bouton
/// de suggestion reste désactivé. Le test est refait à chaque changement de
/// modèle et à chaque révision de la grille — la clé inclut les deux.
model AiCalibration {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  /// Identifiant du modèle testé (env.AI_MODEL, ou "heuristic" hors ligne).
  provider    String
  /// Version de la grille au moment du test — "v1 (cvId)".
  gridVersion String
  /// Résultats par dossier : [{label, referenceTotal, proposedTotal,
  /// totalGap, maxBandDeviation, ok}].
  results     Json
  passed      Boolean
  createdById String?
  createdAt   DateTime @default(now())

  @@index([courseId])
}

/// Outbound notification (peer congratulations, re-engagement nudges, admin signals).
/// Enqueued by the engine, delivered by the dispatcher job.
model Notification {
  id            String              @id @default(cuid())
  enrollmentId  String?
  enrollment    Enrollment?         @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  recipientKind RecipientKind
  recipient     String // email or identifier
  channel       NotificationChannel @default(CONSOLE)
  subject       String?
  body          String
  /// True when the body was produced by the AI provider (vs. template fallback).
  aiGenerated   Boolean             @default(false)
  /// Name of the AI / delivery provider used.
  provider      String?
  status        NotificationStatus  @default(PENDING)
  error         String?
  attempts      Int                 @default(0)
  createdAt     DateTime            @default(now())
  sentAt        DateTime?

  @@index([status])
  @@index([enrollmentId])
}
