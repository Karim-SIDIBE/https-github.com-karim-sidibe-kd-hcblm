{
  "name": "@kd/mobile",
  "private": true,
  "version": "0.1.0",
  "description": "Optional Capacitor (iOS/Android) wrappers around the DECLICK DIGITAL PWA (white-label: VITE_BRAND_NAME). Reserve channel for clients requiring an App Store / Play Store presence — the PWA stays primary.",
  "type": "module",
  "scripts": {
    "build:web": "npm -w web run build",
    "add:ios": "cap add ios",
    "add:android": "cap add android",
    "sync": "cap sync",
    "sync:ios": "cap sync ios",
    "sync:android": "cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android",
    "run:ios": "cap run ios",
    "run:android": "cap run android",
    "doctor": "cap doctor",
    "assets": "npx --yes @capacitor/assets generate --assetPath resources",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/network": "^8.0.1",
    "@capacitor/push-notifications": "^8.1.2",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "~8.5.0",
    "typescript": "^7.0.2"
  }
}
